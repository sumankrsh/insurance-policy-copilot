# Databricks Configuration
DATABRICKS_HOST=https://adb-<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=your-databricks-token-here
DATABRICKS_CATALOG=insurance_copilot
DATABRICKS_SCHEMA=policy_data

# Azure OpenAI Configuration
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT=insurancecopilot
AZURE_STORAGE_KEY=your-storage-key-here
AZURE_STORAGE_CONTAINER=policy-documents

# MLflow Configuration
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Shared/insurance-copilot-experiments

# Redis Configuration (for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Streamlit Configuration
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Model Configuration
MODEL_NAME=surrender_propensity_model
MODEL_VERSION=Production
OPTIMAL_THRESHOLD=0.5

# Feature Store
FEATURE_STORE_TABLE=insurance_copilot.features.customer_features

# Environment
ENVIRONMENT=development  # development, staging, production