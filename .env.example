# Copy to .env and set what you need. Everything is optional: with nothing set, the API
# answers from the documents without an LLM (offline extractive mode).

# Answer generator: auto | anthropic | azure_openai | extractive
# "auto" uses Claude if ANTHROPIC_API_KEY is set, then Azure OpenAI if it is configured.
LLM_PROVIDER=auto

# Anthropic Claude
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Azure OpenAI (pip install -r requirements-azure.txt)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Retrieval
RETRIEVAL_TOP_K=4
MIN_RETRIEVAL_SCORE=0.12

# Retention decision thresholds (see ml/decision.py)
HIGH_RISK_THRESHOLD=0.5
MEDIUM_RISK_THRESHOLD=0.25

# SQLite file for the audit log and review queue (default: var/audit.db)
# AUDIT_DB_PATH=var/audit.db

# Streamlit UI: where the API is running
# API_BASE_URL=http://localhost:8000

# Optional MLflow tracking for `python -m ml.train_propensity --mlflow`
# (pip install -r requirements-databricks.txt)
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=/Shared/insurance-policy-copilot
# DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
# DATABRICKS_TOKEN=
